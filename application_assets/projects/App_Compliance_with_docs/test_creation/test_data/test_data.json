[
  {
    "testdata_id": "TD-001",
    "scenario_id": "GEN_BS_001",
    "scenario_title": "Toggle Application Theme using Dark Mode Switch",
    "actor": "User",
    "positive_dataset": [
      {
        "field_name": "click_toggle_switch",
        "field_type": "navigation",
        "value": "LOC-0001"
      },
      {
        "field_name": "assert_active_theme",
        "field_type": "assertion",
        "value": "dark"
      },
      {
        "field_name": "assert_theme_class",
        "field_type": "assertion",
        "value": "theme-dark"
      }
    ],
    "negative_variants": [
      {
        "variant_id": "NEG-001",
        "variant_type": "negative",
        "description": "Theme toggle fails to update application visual theme to dark mode",
        "iterations": [
          {
            "fields": [
              {
                "field_name": "click_toggle_switch",
                "field_type": "navigation",
                "value": "LOC-0001"
              },
              {
                "field_name": "assert_active_theme",
                "field_type": "assertion",
                "value": "light"
              },
              {
                "field_name": "assert_theme_class",
                "field_type": "assertion",
                "value": "theme-light"
              }
            ],
            "expected_error": "Visual theme failed to switch to dark mode"
          }
        ]
      }
    ]
  },
