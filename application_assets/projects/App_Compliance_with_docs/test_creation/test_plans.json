{
  "GEN_BS_001": {
    "tests": [
      {
        "name": "positive — toggle application theme to dark mode using dark mode switch",
        "type": "positive",
        "steps": [
          {
            "action": "navigate"
          },
          {
            "action": "click",
            "locator_key": "switch_to_dark_mode"
          },
          {
            "action": "verifyVisible",
            "locator_key": "switch_to_dark_mode",
            "message": "Dark mode switch should be visible on the page after toggling theme"
          }
        ]
      }
    ],
    "missing_actions": [],
    "missing_locators": [
      "Element or container locator to verify application theme attribute or theme class (e.g. theme-dark)"
    ]
  },
  "GEN_BS_002": {
    "tests": [
      {
        "name": "positive — open demo project successfully loads project page",
        "type": "positive",
        "steps": [
          {
            "action": "navigate"
          },
          {
            "action": "click",
            "locator_key": "open_the_demo_project"
          },
          {
            "action": "verifyUrlContains",
            "value": "/projects/demo",
            "message": "URL should contain /projects/demo after opening the demo project"
          },
          {
            "action": "verifyTitleContains",
            "value": "Demo Project",
            "message": "Page title should contain Demo Project"
          }
        ]
      },
      {
        "name": "positive — switch to dark mode toggles dark theme",
        "type": "positive",
        "steps": [
          {
            "action": "navigate"
          },
          {
            "action": "click",
            "locator_key": "switch_to_dark_mode"
          }
        ]
      },
      {
        "name": "negative — opening demo project handles load failure state",
        "type": "negative",
        "steps": [
          {
            "action": "navigate"
          },
          {
            "action": "click",
            "locator_key": "open_the_demo_project"
          },
          {
            "action": "verifyUrlContains",
            "value": "/error/404",
            "message": "URL should redirect to 404 error page when demo project content fails to load"
          }
        ]
      }
    ],
    "missing_actions": [],
    "missing_locators": [
      "widgets_container (element to assert demo project widget count)",
      "error_message_toast (element to display 'Unable to load demo project. Please try again later.')",
      "theme_status_indicator (element to assert dark mode state after toggle)"
    ]
  },
