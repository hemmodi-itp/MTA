{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "application_assets/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/test_execution/reports/**",
    "**/test-results/**",
    "**/playwright-report/**"
  ]
}
