# MTA project manifest for the Buggy Shop benchmark app.
# Rendered by the benchmark runner: {{BASE_URL}} (e.g. http://127.0.0.1:8765) and
# {{PROJECT_NAME}} are substituted, then written to
# application_assets/projects/{{PROJECT_NAME}}/project.yaml alongside inputs/brd_<module>.md
# (one BRD per module, split from brd.md by tools/benchmark/materialize.py — each module's
# comprehension then sees only its own requirements).
project:
  name: {{PROJECT_NAME}}
  application_name: Buggy Shop
  browser: chromium
  headless: true
  interactive_scan: false
  discovery_timeout_s: 180

input:
  brd_dir: application_assets/projects/{{PROJECT_NAME}}/inputs

environment: local

safety:
  allow_destructive: true
  allow_security_probes: true
  allowed_hosts:
    - 127.0.0.1
    - localhost

contracts:
  enforce: block

test_types:
  accessibility: true      # Phase 7: @a11y axe specs (tools/nonfunctional/generate.py)
  security_passive: true   # Phase 7: @security header/cookie/storage specs (reads responses; no attack payloads)
  performance: true        # Phase 7: timing budgets (AC-02.6: the Products page within 2 s)
  resilience: true         # Phase 7: offline / slow network / unusual search input
  links: true              # every same-origin link answers (AC-08.1)
  api: true                # Phase 8: API tests per endpoint from code_rules + api_inventory

nfr:
  performance:
    budget: { load_ms: 2000 }   # AC-02.6
  security_passive:
    accepted:                   # real findings on buggy_shop, but no BRD requirement asks for these headers —
      - { rule: csp, reason: "not required by the buggy_shop BRD" }         # still reported, as warnings
      - { rule: framing, reason: "not required by the buggy_shop BRD" }
      - { rule: referrer-policy, reason: "not required by the buggy_shop BRD" }
      - { rule: x-content-type-options, reason: "not required by the buggy_shop BRD" }

white_box:                 # Phase 8: validation rules, routes and contract checks read from the app's source
  enabled: true
  source_dir: benchmarks/apps/buggy_shop

api_tests:                 # Phase 8: resources that belong to one role (another user must be denied)
  ownership:
    - { path: /api/orders/1, owner: admin, other: user }
    - { path: /orders/1, owner: admin, other: user }

health_check:              # Phase 10: an app that is down blocks the run (exit 3) instead of failing every test
  enabled: true
  timeout_s: 10

requirements:
  enabled: true      # Phase 1: requirements.json, AC-linked + tagged tests, traceability.json

discovery:
  deep: true         # Phase 2: deep capture + crawl + form probes + network + roles + baseline
  max_pages: 25      # per role
  max_depth: 4
  max_minutes: 10

auth:
  enabled: false     # no single-identity auth; modules log in through their setup steps
  roles:             # Phase 2 role-aware discovery (read even though auth.enabled is false)
    user:
      strategy: setup
      steps:
        - goto: {{BASE_URL}}/login
        - fill:
            selector: "#username"
            value: alice
        - fill:
            selector: "#password"
            value: alice-pass-1
        - click: "#login-button"
        - wait: 500
    admin:
      strategy: setup
      steps:
        - goto: {{BASE_URL}}/login
        - fill:
            selector: "#username"
            value: admin
        - fill:
            selector: "#password"
            value: admin-pass-1
        - click: "#login-button"
        - wait: 500
    guest:
      anonymous: true

modules:
  - id: M01
    name: Login
    url: {{BASE_URL}}/login
    brd_file: brd_M01.md

  - id: M02
    name: Products
    url: {{BASE_URL}}/products
    brd_file: brd_M02.md
    role: user            # used only with execution.module_roles: true
    setup:
      - goto: {{BASE_URL}}/login
      - fill:
          selector: "#username"
          value: alice
      - fill:
          selector: "#password"
          value: alice-pass-1
      - click: "#login-button"
      - wait: 500

  - id: M03
    name: Product Form
    url: {{BASE_URL}}/products/new
    brd_file: brd_M03.md
    role: user            # used only with execution.module_roles: true
    setup:
      - goto: {{BASE_URL}}/login
      - fill:
          selector: "#username"
          value: alice
      - fill:
          selector: "#password"
          value: alice-pass-1
      - click: "#login-button"
      - wait: 500

  - id: M04
    name: Cart & Checkout
    url: {{BASE_URL}}/cart
    brd_file: brd_M04.md
    role: user            # used only with execution.module_roles: true
    setup:
      - goto: {{BASE_URL}}/login
      - fill:
          selector: "#username"
          value: alice
      - fill:
          selector: "#password"
          value: alice-pass-1
      - click: "#login-button"
      - wait: 500

  - id: M05
    name: Upload
    url: {{BASE_URL}}/upload
    brd_file: brd_M05.md
    role: user            # used only with execution.module_roles: true
    setup:
      - goto: {{BASE_URL}}/login
      - fill:
          selector: "#username"
          value: alice
      - fill:
          selector: "#password"
          value: alice-pass-1
      - click: "#login-button"
      - wait: 500

  - id: M06
    name: Admin
    url: {{BASE_URL}}/admin
    brd_file: brd_M06.md
    role: admin            # used only with execution.module_roles: true
    setup:
      - goto: {{BASE_URL}}/login
      - fill:
          selector: "#username"
          value: admin
      - fill:
          selector: "#password"
          value: admin-pass-1
      - click: "#login-button"
      - wait: 500

oracles:
  enabled: true   # Phase 5: assertion linter + verifyNoNewConsoleErrors on every test (default off elsewhere)

test_generation:
  profile: standard  # Phase 3: test design (techniques + risk + budget) → test_cases.json
  budget: { max_tests: 400, max_runtime_minutes: 45 }
  max_data_iterations: 1   # still read by TestData's per-scenario variants

test_execution:
  suite: {{PROJECT_NAME}}

execution:           # Phase 4 Playwright runtime
  role_auth: true    # log user/admin in once per run (.auth/<role>.json) for test.use({ role })
  suite_mode: grep   # test_suites/*.json -> one --grep run
  module_roles: false  # true -> modules[].role renders test.use({ role }) instead of the setup login. Off here:
                       # buggy_shop keeps the flash message per session, so one shared role session leaks it
                       # between parallel tests, and the app restarts per bug (set role_auth_max_age_minutes: 0).

reporting:
  enhanced: true   # Phase 11-lean: executive summary, traceability CSV, defect list (default off elsewhere)

quality_gates:     # Phase 11-lean: a failed gate -> `python -m tools.reporting.summary <report.json>` exits 1
  p0_pass_rate: 100
  requirement_coverage: 90
