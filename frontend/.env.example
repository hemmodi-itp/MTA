# Copy to .env and fill in. Placeholders only: never commit real values.

# Postgres used by Prisma (frontend) and the Python evaluation service (tools/agent_eval/run_store.py)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# MTA evaluation service (repo root: python -m uvicorn api.server:app --port 8100)
AQP_BACKEND_URL="http://127.0.0.1:8100"
# Shared secret sent as X-AQP-Token on every call to the service; must match AQP_BACKEND_TOKEN on the service
AQP_BACKEND_TOKEN="change-me-long-random-string"

# Key for encrypting live-app test logins (AES-256-GCM); must match AQP_SECRET_KEY on the service
AQP_SECRET_KEY="change-me-long-random-string"

# 1 = allow live URLs on localhost / private networks (local development only). Leave unset in any shared deployment.
# AQP_ALLOW_PRIVATE_TARGETS="1"

# Optional: where the service stores run artifacts (screenshots, page text). Default: ../.aqp_artifacts
# AQP_ARTIFACT_DIR="/path/to/.aqp_artifacts"

# Optional: raises the GitHub API rate limit for the public-repo check
# GITHUB_TOKEN=""
