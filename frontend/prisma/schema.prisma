generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  queued
  cloning
  installing
  launching
  running
  completed
  failed
  cancelled // stopped by the user (queued runs directly; active runs at the worker's next checkpoint)
}

enum PipelineStage {
  discovery
  testdata
  semantic_map
  script_generation
  ui_execution
  healing
  reporting
  // Agent-evaluation pipeline (workflows/agent_evaluation.yaml)
  repo_fetch
  repo_analysis
  brd
  test_generation
  static_review
  live_execution
  scoring
  // MTA redesign: evaluation core
  repo_intelligence
  traceability
  review
  runtime_discovery
  app_classification
  action_generation
  playwright_execution
  evidence_collection
  output_validation
  pass_fail
  brd_compliance
  final_report
}

// What the user told us about their agent at submission time.
enum SubmissionMode {
  brd_and_live // repo contains a BRD + agent is deployed
  live_only // agent is deployed, no BRD (AQP generates one with Gemini)
  brd_only // BRD in repo, not deployed (static review only)
}

enum StepStatus {
  pending
  running
  success
  failed
  skipped
}

enum RequirementStatus {
  implemented
  partial
  missing
  unknown
}

// pending | passed | failed | inconclusive | not_executed are current; skipped/healed are legacy.
enum TestStatus {
  passed
  failed
  healed
  skipped
  pending
  not_executed
  inconclusive // ran, but the evidence supports neither pass nor fail (errorSummary says why)
}

enum RiskLevel {
  low
  medium
  high
}

enum RecommendationCategory {
  failed_test
  coverage_gap
  weak_validation
  missing_negative_case
  flaky_behavior
}

enum Severity {
  critical
  warning
  info
}

enum EvidenceType {
  scenario
  test_case
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  projects     Project[]
  sessions     Session[]
}

// Server-side session. The cookie carries a random token; only its SHA-256
// hash is stored here, so a leaked DB row can't be replayed as a cookie.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // purge of expired sessions
}

model Project {
  id               String         @id @default(cuid())
  name             String
  githubUrl        String
  branch           String         @default("main")
  mode             SubmissionMode @default(brd_and_live)
  liveUrl          String?
  brdPath          String?
  // Test login for the live app, AES-256-GCM encrypted (tools/agent_eval/secrets_box.py). Never returned by the API.
  liveAuth         String?
  lastRunStatus    RunStatus      @default(queued)
  lastQualityScore Int?
  // Demo projects visible to every user; everything else is visible only to its owner (userId).
  isSample         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  runs Run[]

  // One project per user + repository. Sample projects have userId NULL, which Postgres treats as distinct.
  @@unique([userId, githubUrl])
  @@index([userId])
}

model Run {
  id           String         @id @default(cuid())
  status       RunStatus      @default(queued)
  currentStage PipelineStage?
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  durationSec  Int?

  // Flattened RunStats — real columns since these are filtered/sorted/aggregated on.
  scenariosFound     Int       @default(0)
  testCasesGenerated Int       @default(0)
  passed             Int       @default(0)
  failed             Int       @default(0)
  healed             Int       @default(0)
  skipped            Int       @default(0)
  coveragePct        Int       @default(0)
  qualityScore       Int       @default(0)
  riskLevel          RiskLevel @default(low)
  criticalDefects    Int       @default(0)
  duplicatesRejected Int       @default(0)

  // Small, fixed-shape, never queried by field — JSON is the pragmatic choice here.
  qualityBreakdown Json @default("[]")
  trend            Json @default("[]")

  // Agent-evaluation inputs, snapshotted per run so re-runs are reproducible.
  mode      SubmissionMode?
  liveUrl   String?
  commitRef String?

  // BRD used for this run — either found in the repo or generated by Gemini.
  brdSource  String? // "repository" | "generated"
  brdPath    String?
  brdContent String?

  agentProfile Json? // Gemini's read of the repo: purpose, capabilities, interface
  summary      String?
  errorMessage String?

  // Run control. The Python worker bumps heartbeatAt every ~30 s while it works on the run, and stops at its next
  // checkpoint (status -> cancelled) once cancelRequested is set. Only one active run per project: enforced in the
  // API routes under a per-project advisory lock (lib/api/server/evaluation.ts).
  heartbeatAt     DateTime?
  cancelRequested Boolean   @default(false)

  // MTA redesign: evidence-weighted compliance (see engines/scoring). Null on older runs.
  snapshotId        String?
  scoringVersion    String?
  scoreKind         String? // brd_compliance | inferred_conformance
  complianceScore   Float?
  ciLow             Float?
  ciHigh            Float?
  verificationDepth Float? // share of runtime-verifiable criteria reaching E4-E5
  scorecard         Json? // {dimension: 0-100}
  gates             Json? // [{gate, level: pass|warn|block, reason}]
  runtimeProfile    Json? // Runtime Discovery Engine output (engines/runtime/discovery.py)
  appClassification Json? // Application Classification Engine output (engines/runtime/classification.py)
  actionPlan        Json? // Action Generation Engine output (engines/runtime/actions.py) — no credentials inside
  executionRun      Json? // Playwright Executor output (engines/runtime/executor.py); files under .aqp_artifacts/runs/<id>
  evidenceCollection Json? // Evidence Collection Engine output (engines/runtime/evidence.py): bundles per criterion
  outputValidation  Json? // Output Validation Engine output (engines/validation/output.py): checks + grounded judgements
  passFail          Json? // Pass/Fail Engine output (engines/verdict/passfail.py): verdicts per test and criterion
  brdCompliance     Json? // BRD Compliance Engine output (engines/compliance/matrix.py): matrix, discrepancies, evidence mix
  finalReport       Json? // Final Evaluation Report (engines/report/final.py): {data, markdown, html}

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  scenarios       Scenario[]
  testCases       TestCase[]
  recommendations Recommendation[]
  steps           RunStep[]
  events          RunEvent[]
  requirements    Requirement[]
  criteria        AcceptanceCriterion[]
  evidenceItems   Evidence[]
  findings        Finding[]

  @@index([projectId, startedAt])
  @@index([status, startedAt])
}

// One row per pipeline step — drives the live stepper in the run view.
model RunStep {
  id         String        @id @default(cuid())
  key        PipelineStage
  label      String
  position   Int
  status     StepStatus    @default(pending)
  detail     String?
  startedAt  DateTime?
  finishedAt DateTime?

  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, key])
  @@index([runId])
  @@index([status, finishedAt]) // time-remaining estimate: recent finished steps
}

// Append-only activity log streamed to the run view while the pipeline works.
model RunEvent {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  level     String         @default("info") // info | warning | error | success
  stage     PipelineStage?
  message   String

  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([createdAt]) // cross-run activity timeline
}

// A requirement extracted from the BRD, plus the static-review verdict on it.
model Requirement {
  id                 String            @id @default(cuid())
  code               String // e.g. REQ-03
  title              String
  description        String
  priority           String            @default("medium") // high | medium | low
  kind               String            @default("functional") // functional | non_functional
  acceptanceCriteria Json              @default("[]")
  section            String? // BRD section / requirement id it came from
  sourceQuote        String? // verbatim BRD text the requirement was extracted from (machine-checked)
  status             RequirementStatus @default(unknown)
  evidence           String?

  // MTA redesign
  verifiability String                @default("both") // static | runtime | both | non_technical
  origin        String                @default("brd") // brd | inferred | descriptive
  confidence    Float                 @default(1)
  verdict       String? // rolled up from its criteria
  score         Float? // 0-1, evidence-weighted
  criteria      AcceptanceCriterion[]

  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// An atomic, checkable statement of a requirement, and the verdict the evidence supports.
model AcceptanceCriterion {
  id             String  @id @default(cuid())
  code           String // AC-03.2
  statement      String
  oracleHint     String  @default("semantic") // deterministic | semantic | static
  weight         Float   @default(1)
  verdict        String? // verified_pass | verified_fail | implemented_static | partial | not_implemented | insufficient_evidence | not_technically_verifiable | contested
  bestStrength   String? // E1-E5
  credit         Float?
  agreement      Float?
  rationale      String?
  negativeSearch Json? // queries + hit counts backing a not_implemented verdict

  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  runId         String
  run           Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence      Evidence[]

  @@unique([runId, code])
  @@index([requirementId])
}

// One piece of evidence for (or against) a criterion, with provenance.
model Evidence {
  id         String   @id @default(cuid())
  method     String // static | structural | repo_test | runtime | doc_claim
  strength   String // E1-E5
  outcome    String // supports | refutes | neutral
  citation   Json? // static: {file, start_line, end_line, symbol, claim, url}
  testCaseId String?
  summary    String
  validated  Boolean  @default(false)
  createdAt  DateTime @default(now())

  criterionId String?
  criterion   AcceptanceCriterion? @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  runId       String
  run         Run                  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, criterionId])
}

// Repository review finding (security, architecture, agent design, readiness...).
model Finding {
  id         String  @id @default(cuid())
  dimension  String
  ruleId     String?
  severity   String // critical | high | medium | low | info
  title      String
  filePath   String?
  startLine  Int?
  endLine    Int?
  rationale  String?
  fix        String?
  source     String // scanner | llm | runtime
  confidence Float   @default(1)

  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, severity])
}

// ── Repository Intelligence: one knowledge graph per (repo, commit, indexer version) ──

model RepoSnapshot {
  id             String   @id @default(cuid())
  repoFullName   String
  commitSha      String
  indexerVersion String
  fileCount      Int      @default(0)
  languages      Json     @default("{}")
  repoModel      Json?
  createdAt      DateTime @default(now())

  nodes  KgNode[]
  edges  KgEdge[]
  chunks CodeChunk[]

  @@unique([repoFullName, commitSha, indexerVersion])
}

model KgNode {
  id        String  @id @default(cuid())
  kind      String // file | symbol | route | page | form | component | agent | tool | prompt | model_call | table | config | dependency | doc_section | test
  key       String // stable identity, e.g. "route:POST /api/generate"
  filePath  String?
  startLine Int?
  endLine   Int?
  name      String?
  props     Json    @default("{}")

  snapshotId String
  snapshot   RepoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, key])
  @@index([snapshotId, kind])
}

model KgEdge {
  src  String
  dst  String
  kind String // defines | imports | calls | exposes | submits_to | calls_api | uses_model | uses_prompt | tests | configured_by | reads | writes

  snapshotId String
  snapshot   RepoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, src, kind, dst])
  @@index([snapshotId, dst])
}

model CodeChunk {
  id        String  @id @default(cuid())
  filePath  String
  startLine Int
  endLine   Int
  symbol    String?
  content   String

  snapshotId String
  snapshot   RepoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, filePath])
}

model Scenario {
  id         String @id @default(cuid())
  title      String
  module     String
  confidence Float

  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model TestCase {
  id            String     @id @default(cuid())
  scenarioTitle String
  module        String
  variantType   String
  status        TestStatus @default(passed)
  durationMs    Int        @default(0)
  healed        Boolean    @default(false)
  errorSummary  String?
  specPreview   String?

  // Agent-evaluation fields (null for legacy Playwright runs).
  category            String? // agent_specific | general
  requirementRef      String?
  priority            String?
  input               String?
  expected            String?
  actualOutput        String?
  judgeReasoning      String?
  judgeScore          Int?
  brdReference        String? // verbatim BRD text this test verifies (machine-checked)
  acceptanceCriterion String?
  criterionCode       String? // AC-xx.y this test produces runtime evidence for

  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model Recommendation {
  id           String                 @id @default(cuid())
  category     RecommendationCategory
  severity     Severity
  summary      String
  // Freeform pointer (a Scenario or TestCase id) — mirrors evidence types loosely
  // linked in the UI rather than one strict foreign key.
  evidenceRef  String
  evidenceType EvidenceType

  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}
