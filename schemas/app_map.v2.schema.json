      },
      "title": "Stopped By",
      "type": "object"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/Transition"
      },
      "title": "Transitions",
      "type": "array"
    }
  },
  "required": [
    "project",
    "generated_at",
    "config_hash"
  ],
  "title": "AppMapDoc",
  "type": "object",
  "x-mta-artifact": "app_map",
  "x-mta-kind": "dict"
}
