      "type": "number"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "project": {
      "title": "Project",
      "type": "string"
    },
    "roles": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Roles",
      "type": "array"
    },
