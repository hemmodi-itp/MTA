      "title": "RevealedBy",
      "type": "object"
    },
    "Skipped": {
      "additionalProperties": false,
      "properties": {
        "element": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
