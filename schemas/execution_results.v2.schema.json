            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "errors": {
          "items": {},
          "title": "Errors",
          "type": "array"
        },
        "flaky": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flaky"
        },
        "spec_file": {
          "title": "Spec File",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "test_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Title"
        }
      },
      "required": [
        "spec_file",
        "status"
      ],
      "title": "TestResult",
      "type": "object"
    }
  },
  "$id": "mta://schemas/execution_results.v2.schema.json",
