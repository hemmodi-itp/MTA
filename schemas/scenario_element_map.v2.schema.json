{
  "$defs": {
    "MappedElement": {
      "additionalProperties": true,
      "properties": {
        "cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cluster"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "locator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator Id"
        },
        "playwright_expr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playwright Expr"
        }
      },
      "title": "MappedElement",
      "type": "object"
    },
    "ScenarioMapEntry": {
      "additionalProperties": true,
      "properties": {
        "relevant_elements": {
          "items": {
