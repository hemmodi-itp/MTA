{
  "$defs": {
    "MtaAttachment": {
      "additionalProperties": true,
      "properties": {
        "content_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "name"
      ],
      "title": "MtaAttachment",
      "type": "object"
    },
    "MtaAttempt": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "retry": {
          "default": 0,
          "title": "Retry",
          "type": "integer"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "MtaAttempt",
      "type": "object"
    },
    "MtaTest": {
      "additionalProperties": true,
      "description": "One test in the MTA Playwright reporter's output (Phase 4.2).",
      "properties": {
        "ac_ids": {
          "items": {
            "type": "string"
          },
          "title": "Ac Ids",
          "type": "array"
        },
        "annotations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Annotations",
          "type": "array"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/MtaAttachment"
          },
          "title": "Attachments",
          "type": "array"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/MtaAttempt"
          },
          "title": "Attempts",
          "type": "array"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "expected_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Status"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "spec_file": {
          "title": "Spec File",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "flaky",
            "skipped",
            "timedOut",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "tc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tc Id"
        },
        "test_id": {
          "title": "Test Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "title_path": {
          "items": {
            "type": "string"
          },
          "title": "Title Path",
          "type": "array"
        }
      },
      "required": [
        "test_id",
        "title",
        "spec_file",
        "status"
      ],
      "title": "MtaTest",
      "type": "object"
    }
  },
  "$id": "mta://schemas/mta_results.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "test_execution/reports/mta/{ts}.mta_results.json — written by\napplication_assets/_shared/runtime/reporters/mta-reporter.ts, read by tools/execution/mta_results.py.",
  "properties": {
    "artifact": {
      "const": "mta_results",
      "default": "mta_results",
      "title": "Artifact",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "project": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "shard": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shard"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/MtaTest"
      },
      "title": "Tests",
      "type": "array"
    },
    "totals": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Totals",
      "type": "object"
    }
  },
  "title": "MtaResultsV2",
  "type": "object",
  "x-mta-artifact": "mta_results",
  "x-mta-kind": "dict"
}
